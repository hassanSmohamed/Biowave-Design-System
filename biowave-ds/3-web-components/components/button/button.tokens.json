{
  "$schema": "component-tokens/v1",
  "$description": "Button component tokens (D-13). Every value aliases a SEMANTIC token from 2-foundations — never a primitive or a raw value. Same facts as spec §3 (checked by npm run component-tokens). Synced to the Web Components file as local collections whose variables alias the Foundations library.",
  "button": {
    "size": {
      "$extensions": {
        "figma": {
          "collection": "Button / Size",
          "modes": true
        }
      },
      "$descriptions": {
        "height": "Button height. Bind to: button frame height. Change size with the Button / Size mode.",
        "padding-inline": "Start and end padding, mirrored in RTL. Bind to: left and right padding.",
        "gap": "Space between items. Bind to: auto-layout gap.",
        "icon-size": "Icon size. Bind to: icon width and height.",
        "radius": "Corner radius. Bind to: frame corner radius.",
        "border-width": "Outlined border width. Bind to: stroke weight of Outlined variants.",
        "focus-ring-radius": "Focus ring corner radius. Bind to: Focus ring layer corner radius."
      },
      "sm": {
        "height": {
          "$value": "{size.control.height.sm}"
        },
        "padding-inline": {
          "$value": "{spacing.control.padding-inline.sm}"
        },
        "gap": {
          "$value": "{spacing.control.gap.sm}"
        },
        "icon-size": {
          "$value": "{size.icon.sm}"
        },
        "radius": {
          "$value": "{radius.md}"
        },
        "border-width": {
          "$value": "{border.width.default}"
        },
        "focus-ring-radius": {
          "$value": "{radius.lg}"
        }
      },
