{
  "$schema": "component-tokens/v1",
  "$description": "Icon button component tokens (D-13). Transparent colours, selected colours, sizes and the temporary tooltip. Filled, outlined, tonal and focus reuse Button / * collections. Every value aliases a semantic token.",
  "icon-button": {
    "size": {
      "$extensions": {
        "figma": {
          "collection": "Icon button / Size",
          "modes": true
        }
      },
      "$descriptions": {
        "size": "Square button size. Bind to: frame width and height.",
        "icon-size": "Icon size. Bind to: icon width and height.",
        "radius": "Corner radius. Bind to: frame corner radius.",
        "border-width": "Border width. Bind to: frame stroke weight."
      },
      "sm": {
        "size": {
          "$value": "{size.control.height.sm}"
        },
        "icon-size": {
          "$value": "{size.icon.sm}"
        },
        "radius": {
          "$value": "{radius.md}"
        },
        "border-width": {
          "$value": "{border.width.default}"
        }
      },
      "md": {
        "size": {
          "$value": "{size.control.height.md}"
        },
        "icon-size": {
          "$value": "{size.icon.md}"
