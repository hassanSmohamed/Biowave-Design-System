{
  "$schema": "component-tokens/v1",
  "$description": "Figma-only Link component-token bridge for R-02. Every value aliases a semantic Foundations token; the Web implementation continues to consume shared semantic tokens directly.",
  "$extensions": {
    "biowave": {
      "figmaOnly": true
    }
  },
  "link": {
    "size": {
      "$extensions": {
        "figma": {
          "collection": "Link / Size",
          "modes": true
        }
      },
      "lg": {
        "height": {
          "$value": "{size.control.height.lg}"
        },
        "padding-inline": {
          "$value": "{spacing.control.padding-inline.lg}"
        },
        "padding-block": {
          "$value": "{spacing.none}"
        },
        "gap": {
          "$value": "{spacing.control.gap.lg}"
        },
        "icon": {
          "$value": "{size.icon.lg}"
        },
        "radius": {
          "$value": "{radius.2xl}"
        }
      },
      "md": {
        "height": {
          "$value": "{size.control.height.md}"
        },
        "padding-inline": {
          "$value": "{spacing.control.padding-inline.md}"
        },
        "padding-block": {
          "$value": "{spacing.none}"
        },
        "gap": {
          "$value": "{spacing.control.gap.md}"
        },
        "icon": {
          "$value": "{size.icon.md}"
        },
        "radius": {
          "$value": "{radius.2xl}"
        }
      },
      "sm": {
        "height": {
          "$value": "{size.control.height.sm}"
        },
        "padding-inline": {
          "$value": "{spacing.control.padding-inline.sm}"
        },
        "padding-block": {
          "$value": "{spacing.none}"
        },
        "gap": {
          "$value": "{spacing.control.gap.sm}"
        },
        "icon": {
          "$value": "{size.icon.sm}"
        },
        "radius": {
          "$value": "{radius.2xl}"
        }
      }
    },
    "color": {
      "$extensions": {
        "figma": {
          "collection": "Link / Color",
          "modes": true
        }
      },
      "brand": {
        "label": {
          "default": {
            "$value": "{color.text.role.brand}"
          },
          "hovered": {
            "$value": "{color.text.role.brand}"
          },
          "pressed": {
            "$value": "{color.text.role.brand}"
          },
          "disabled": {
            "$value": "{color.text.disabled}"
          }
        },
        "icon": {
          "default": {
            "$value": "{color.icon.role.brand}"
          },
          "hovered": {
            "$value": "{color.icon.role.brand}"
          },
          "pressed": {
            "$value": "{color.icon.role.brand}"
          },
          "disabled": {
            "$value": "{color.icon.disabled}"
          }
        },
        "container": {
          "$value": "{color.background.transparent.default}"
        },
        "border": {
          "$value": "{color.border.default}"
        },
        "focus-ring": {
          "$value": "{color.border.focus}",
          "outer": {
            "$value": "{color.text.role.brand}"
          },
          "inner": {
            "$value": "{color.text.on.brand}"
          }
        }
      },
      "secondary": {
        "label": {
          "default": {
            "$value": "{color.text.role.secondary}"
          },
          "hovered": {
            "$value": "{color.text.role.secondary}"
          },
          "pressed": {
            "$value": "{color.text.role.secondary}"
          },
          "disabled": {
            "$value": "{color.text.disabled}"
          }
        },
        "icon": {
          "default": {
            "$value": "{color.icon.role.secondary}"
          },
          "hovered": {
            "$value": "{color.icon.role.secondary}"
          },
          "pressed": {
            "$value": "{color.icon.role.secondary}"
          },
          "disabled": {
            "$value": "{color.icon.disabled}"
          }
        },
        "container": {
          "$value": "{color.background.transparent.default}"
        },
        "border": {
          "$value": "{color.border.default}"
        },
        "focus-ring": {
          "$value": "{color.border.focus}",
          "outer": {
            "$value": "{color.text.role.secondary}"
          },
          "inner": {
            "$value": "{color.text.on.brand}"
          }
        }
      },
      "success": {
        "label": {
          "default": {
            "$value": "{color.text.role.success}"
          },
          "hovered": {
            "$value": "{color.text.role.success}"
          },
          "pressed": {
            "$value": "{color.text.role.success}"
          },
          "disabled": {
            "$value": "{color.text.disabled}"
          }
        },
        "icon": {
          "default": {
            "$value": "{color.icon.role.success}"
          },
          "hovered": {
            "$value": "{color.icon.role.success}"
          },
          "pressed": {
            "$value": "{color.icon.role.success}"
          },
          "disabled": {
            "$value": "{color.icon.disabled}"
          }
        },
        "container": {
          "$value": "{color.background.transparent.default}"
        },
        "border": {
          "$value": "{color.border.default}"
        },
        "focus-ring": {
          "$value": "{color.border.focus}",
          "outer": {
            "$value": "{color.text.role.success}"
          },
          "inner": {
            "$value": "{color.text.on.brand}"
          }
        }
      },
      "error": {
        "label": {
          "default": {
            "$value": "{color.text.role.error}"
          },
          "hovered": {
            "$value": "{color.text.role.error}"
          },
          "pressed": {
            "$value": "{color.text.role.error}"
          },
          "disabled": {
            "$value": "{color.text.disabled}"
          }
        },
        "icon": {
          "default": {
            "$value": "{color.icon.role.error}"
          },
          "hovered": {
            "$value": "{color.icon.role.error}"
          },
          "pressed": {
            "$value": "{color.icon.role.error}"
          },
          "disabled": {
            "$value": "{color.icon.disabled}"
          }
        },
        "container": {
          "$value": "{color.background.transparent.default}"
        },
        "border": {
          "$value": "{color.border.default}"
        },
        "focus-ring": {
          "$value": "{color.border.focus}",
          "outer": {
            "$value": "{color.text.role.error}"
          },
          "inner": {
            "$value": "{color.text.on.brand}"
          }
        }
      },
      "warning": {
        "label": {
          "default": {
            "$value": "{color.text.role.warning}"
          },
          "hovered": {
            "$value": "{color.text.role.warning}"
          },
          "pressed": {
            "$value": "{color.text.role.warning}"
          },
          "disabled": {
            "$value": "{color.text.disabled}"
          }
        },
        "icon": {
          "default": {
            "$value": "{color.icon.role.warning}"
          },
          "hovered": {
            "$value": "{color.icon.role.warning}"
          },
          "pressed": {
            "$value": "{color.icon.role.warning}"
          },
          "disabled": {
            "$value": "{color.icon.disabled}"
          }
        },
        "container": {
          "$value": "{color.background.transparent.default}"
        },
        "border": {
          "$value": "{color.border.default}"
        },
        "focus-ring": {
          "$value": "{color.border.focus}",
          "outer": {
            "$value": "{color.background.warning.pressed}"
          },
          "inner": {
            "$value": "{color.text.on.brand}"
          }
        }
      },
      "info": {
        "label": {
          "default": {
            "$value": "{color.text.role.info}"
          },
          "hovered": {
            "$value": "{color.text.role.info}"
          },
          "pressed": {
            "$value": "{color.text.role.info}"
          },
          "disabled": {
            "$value": "{color.text.disabled}"
          }
        },
        "icon": {
          "default": {
            "$value": "{color.icon.role.info}"
          },
          "hovered": {
            "$value": "{color.icon.role.info}"
          },
          "pressed": {
            "$value": "{color.icon.role.info}"
          },
          "disabled": {
            "$value": "{color.icon.disabled}"
          }
        },
        "container": {
          "$value": "{color.background.transparent.default}"
        },
        "border": {
          "$value": "{color.border.default}"
        },
        "focus-ring": {
          "$value": "{color.border.focus}",
          "outer": {
            "$value": "{color.text.role.info}"
          },
          "inner": {
            "$value": "{color.text.on.brand}"
          }
        }
      },
      "neutral": {
        "label": {
          "default": {
            "$value": "{color.text.subtle}"
          },
          "hovered": {
            "$value": "{color.text.subtle}"
          },
          "pressed": {
            "$value": "{color.text.default}"
          },
          "disabled": {
            "$value": "{color.text.disabled}"
          }
        },
        "icon": {
          "default": {
            "$value": "{color.icon.subtle}"
          },
          "hovered": {
            "$value": "{color.icon.subtle}"
          },
          "pressed": {
            "$value": "{color.icon.default}"
          },
          "disabled": {
            "$value": "{color.icon.disabled}"
          }
        },
        "container": {
          "$value": "{color.background.transparent.default}"
        },
        "border": {
          "$value": "{color.border.default}"
        },
        "focus-ring": {
          "$value": "{color.border.focus}",
          "outer": {
            "$value": "{color.text.subtle}"
          },
          "inner": {
            "$value": "{color.text.on.brand}"
          }
        }
      },
      "inverse": {
        "label": {
          "default": {
            "$value": "{color.text.inverse}"
          },
          "hovered": {
            "$value": "{color.text.inverse}"
          },
          "pressed": {
            "$value": "{color.text.inverse}"
          },
          "disabled": {
            "$value": "{color.text.disabled}"
          }
        },
        "icon": {
          "default": {
            "$value": "{color.icon.inverse}"
          },
          "hovered": {
            "$value": "{color.icon.inverse}"
          },
          "pressed": {
            "$value": "{color.icon.inverse}"
          },
          "disabled": {
            "$value": "{color.icon.disabled}"
          }
        },
        "container": {
          "$value": "{color.background.transparent.default}"
        },
        "border": {
          "$value": "{color.border.default}"
        },
        "focus-ring": {
          "$value": "{color.border.inverse}",
          "outer": {
            "$value": "{color.text.on.brand}"
          },
          "inner": {
            "$value": "{color.text.default}"
          }
        }
      }
    }
  }
}
