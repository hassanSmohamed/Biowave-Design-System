{
  "$schema": "component-tokens/v1",
  "$description": "Figma-only Link component-token bridge for R-02. Every value aliases a semantic Foundations token; the Web implementation continues to consume shared semantic tokens directly.",
  "$extensions": {
    "biowave": {
      "figmaOnly": true
    }
  },
  "link": {
    "size": {
      "$extensions": {
        "figma": {
          "collection": "Link / Size",
          "modes": true
        }
      },
      "$descriptions": {
        "height": "Link height. Bind to: variant min and max height.",
        "padding-inline": "Start and end padding, mirrored in RTL. Bind to: left and right padding.",
        "padding-block": "Top and bottom padding. Bind to: top and bottom padding.",
        "gap": "Space between items. Bind to: auto-layout gap.",
        "icon-size": "Icon size. Bind to: icon width and height.",
        "radius": "Corner radius. Bind to: frame corner radius.",
        "focus-ring-width": "Focus ring width. Bind to: Border stroke weight in Focused variants."
      },
      "lg": {
        "height": {
          "$value": "{size.control.height.lg}"
        },
        "padding-inline": {
          "$value": "{spacing.control.padding-inline.lg}"
        },
        "padding-block": {
          "$value": "{spacing.none}"
        },
        "gap": {
          "$value": "{spacing.control.gap.lg}"
        },
        "icon-size": {
          "$value": "{size.icon.lg}"
        },
        "radius": {
          "$value": "{radius.2xl}"
        },
        "focus-ring-width": {
          "$value": "{border.width.focus}"
        }
      },
      "md": {
        "height": {
          "$value": "{size.control.height.md}"
        },
        "padding-inline": {
          "$value": "{spacing.control.padding-inline.md}"
        },
        "padding-block": {
          "$value": "{spacing.none}"
        },
        "gap": {
          "$value": "{spacing.control.gap.md}"
        },
        "icon-size": {
          "$value": "{size.icon.md}"
        },
        "radius": {
          "$value": "{radius.2xl}"
        },
        "focus-ring-width": {
          "$value": "{border.width.focus}"
        }
      },
      "sm": {
        "height": {
          "$value": "{size.control.height.sm}"
        },
        "padding-inline": {
          "$value": "{spacing.control.padding-inline.sm}"
        },
        "padding-block": {
          "$value": "{spacing.none}"
        },
        "gap": {
          "$value": "{spacing.control.gap.sm}"
        },
        "icon-size": {
          "$value": "{size.icon.sm}"
        },
        "radius": {
          "$value": "{radius.2xl}"
        },
        "focus-ring-width": {
          "$value": "{border.width.focus}"
        }
      }
    },
    "color": {
      "$extensions": {
        "figma": {
          "collection": "Link / Color",
          "modes": true
        }
      },
      "$descriptions": {
        "label/default": "Label colour at rest and when focused. Bind to: label text fill.",
        "label/hovered": "Label colour on hover. Bind to: label text fill in Hovered variants.",
        "label/visited": "Label colour for a visited link. Brand only; neutral and inverse keep their default colour. Bind to: label text fill in Visited variants.",
        "label/disabled": "Label colour when disabled. Bind to: label text fill in Disabled variants.",
        "icon/default": "Icon colour at rest and when focused. Bind to: icon fill.",
        "icon/hovered": "Icon colour on hover. Bind to: icon fill in Hovered variants.",
        "icon/visited": "Icon colour for a visited link. Matches label. Bind to: icon fill in Visited variants.",
        "icon/disabled": "Icon colour when disabled. Bind to: icon fill in Disabled variants.",
        "container": "Transparent link container. Bind to: variant and icon wrapper fills.",
        "border": "Border colour. Bind to: Border layer stroke.",
        "focus-ring": "Focus ring colour. Follows the link colour. Bind to: Border stroke in Focused variants. Mode driven by: Color."
      },
      "brand": {
        "label": {
          "default": {
            "$value": "{color.link.default}"
          },
          "hovered": {
            "$value": "{color.link.hovered}"
          },
          "visited": {
            "$value": "{color.link.visited}"
          },
          "disabled": {
            "$value": "{color.text.disabled}"
          }
        },
        "icon": {
          "default": {
            "$value": "{color.link.default}"
          },
          "hovered": {
            "$value": "{color.link.hovered}"
          },
          "visited": {
            "$value": "{color.link.visited}"
          },
          "disabled": {
            "$value": "{color.icon.disabled}"
          }
        },
        "container": {
          "$value": "{color.background.transparent.default}"
        },
        "border": {
          "$value": "{color.border.default}"
        },
        "focus-ring": {
          "$value": "{color.border.info}"
        }
      },
      "neutral": {
        "label": {
          "default": {
            "$value": "{color.text.default}"
          },
          "hovered": {
            "$value": "{color.text.default}"
          },
          "visited": {
            "$value": "{color.text.default}"
          },
          "disabled": {
            "$value": "{color.text.disabled}"
          }
        },
        "icon": {
          "default": {
            "$value": "{color.icon.default}"
          },
          "hovered": {
            "$value": "{color.icon.default}"
          },
          "visited": {
            "$value": "{color.icon.default}"
          },
          "disabled": {
            "$value": "{color.icon.disabled}"
          }
        },
        "container": {
          "$value": "{color.background.transparent.default}"
        },
        "border": {
          "$value": "{color.border.default}"
        },
        "focus-ring": {
          "$value": "{color.border.bold}"
        }
      },
      "inverse": {
        "label": {
          "default": {
            "$value": "{color.text.inverse}"
          },
          "hovered": {
            "$value": "{color.text.inverse}"
          },
          "visited": {
            "$value": "{color.text.inverse}"
          },
          "disabled": {
            "$value": "{color.text.disabled}"
          }
        },
        "icon": {
          "default": {
            "$value": "{color.icon.inverse}"
          },
          "hovered": {
            "$value": "{color.icon.inverse}"
          },
          "visited": {
            "$value": "{color.icon.inverse}"
          },
          "disabled": {
            "$value": "{color.icon.disabled}"
          }
        },
        "container": {
          "$value": "{color.background.transparent.default}"
        },
        "border": {
          "$value": "{color.border.default}"
        },
        "focus-ring": {
          "$value": "{color.border.inverse}"
        }
      }
    }
  }
}
