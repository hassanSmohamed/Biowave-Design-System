{
  "$schema": "component-tokens/v1",
  "$description": "Text field component tokens (D-13). Every value aliases a semantic Foundations token.",
  "text-field": {
    "size": {
      "$extensions": {
        "figma": {
          "collection": "Text field / Size",
          "modes": true
        }
      },
      "$descriptions": {
        "height": "Control height. Bind to: frame height.",
        "padding-inline": "Start and end padding, mirrored in RTL. Bind to: left and right padding.",
        "gap": "Space between items. Bind to: auto-layout gap.",
        "label-gap": "Space between label and field. Bind to: gap of the stack that holds them.",
        "supporting-gap": "Space between field and supporting text. Bind to: gap of the stack that holds them.",
        "icon-size": "Icon size. Bind to: icon width and height.",
        "radius": "Corner radius. Bind to: frame corner radius.",
        "border-width": "Base border width for this size. Bind Text field / State › border-width on the container instead.",
        "action-size": "Hit box of the trailing action. Bind to: action frame width and height.",
        "action-inset": "Space between the trailing action and the field end. Bind to: end padding when an action shows."
      },
      "sm": {
        "height": {
          "$value": "{size.control.height.sm}"
        },
        "padding-inline": {
          "$value": "{spacing.control.padding-inline.sm}"
        },
        "gap": {
          "$value": "{spacing.control.gap.sm}"
        },
        "label-gap": {
          "$value": "{spacing.sm}"
        },
        "supporting-gap": {
          "$value": "{spacing.xs}"
        },
        "icon-size": {
          "$value": "{size.icon.sm}"
        },
        "radius": {
          "$value": "{radius.md}"
        },
        "border-width": {
          "$value": "{border.width.default}"
        },
        "action-size": {
          "$value": "{size.icon.lg}"
        },
        "action-inset": {
          "$value": "{spacing.xs}"
        }
      },
      "md": {
        "height": {
          "$value": "{size.control.height.md}"
        },
        "padding-inline": {
          "$value": "{spacing.control.padding-inline.md}"
        },
        "gap": {
          "$value": "{spacing.control.gap.md}"
        },
        "label-gap": {
          "$value": "{spacing.sm}"
        },
        "supporting-gap": {
          "$value": "{spacing.xs}"
        },
        "icon-size": {
          "$value": "{size.icon.md}"
        },
        "radius": {
          "$value": "{radius.md}"
        },
        "border-width": {
          "$value": "{border.width.default}"
        },
        "action-size": {
          "$value": "{size.control.height.sm}"
        },
        "action-inset": {
          "$value": "{spacing.xs}"
        }
      },
      "lg": {
        "height": {
          "$value": "{size.control.height.lg}"
        },
        "padding-inline": {
          "$value": "{spacing.control.padding-inline.lg}"
        },
        "gap": {
          "$value": "{spacing.control.gap.lg}"
        },
        "label-gap": {
          "$value": "{spacing.sm}"
        },
        "supporting-gap": {
          "$value": "{spacing.xs}"
        },
        "icon-size": {
          "$value": "{size.icon.lg}"
        },
        "radius": {
          "$value": "{radius.md}"
        },
        "border-width": {
          "$value": "{border.width.default}"
        },
        "action-size": {
          "$value": "{size.control.height.md}"
        },
        "action-inset": {
          "$value": "{spacing.xs}"
        }
      }
    },
    "state": {
      "$extensions": {
        "figma": {
          "collection": "Text field / State",
          "modes": true
        }
      },
      "$descriptions": {
        "container": "Field fill per state. Bind to: field container fill.",
        "border": "Field border colour per state. Always a real stroke, never a shadow. Bind to: field container stroke.",
        "border-width": "Field border width per state. Bind to: field container stroke weight.",
        "label": "Label colour above the field. Bind to: label text fill.",
        "input": "Typed value colour. Bind to: input text fill.",
        "placeholder": "Placeholder colour. Never use a placeholder as the label. Bind to: placeholder text fill.",
        "icon": "Colour of leading and trailing icons. Bind to: icon fill.",
        "supporting": "Helper text colour; turns error in the error state. Bind to: supporting text fill.",
        "counter": "Character counter colour. Bind to: counter text fill.",
        "required": "Required marker colour. Bind to: required text fill.",
        "addon-container": "Prefix or suffix fill. Bind to: add-on frame fill.",
        "addon-label": "Prefix or suffix text colour. Bind to: add-on text fill.",
        "error-icon": "Error icon colour. Bind to: error icon fill."
      },
      "default": {
        "container": {
          "$value": "{color.background.base.default}"
        },
        "border": {
          "$value": "{color.border.bold}"
        },
        "border-width": {
          "$value": "{border.width.default}"
        },
        "label": {
          "$value": "{color.text.default}"
        },
        "input": {
          "$value": "{color.text.default}"
        },
        "placeholder": {
          "$value": "{color.text.subtlest}"
        },
        "icon": {
          "$value": "{color.icon.subtlest}"
        },
        "supporting": {
          "$value": "{color.text.subtlest}"
        },
        "counter": {
          "$value": "{color.text.subtlest}"
        },
        "required": {
          "$value": "{color.text.role.error}"
        },
        "addon-container": {
          "$value": "{color.background.neutral.default}"
        },
        "addon-label": {
          "$value": "{color.text.subtle}"
        },
        "error-icon": {
          "$value": "{color.icon.role.error}"
        }
      },
      "hovered": {
        "container": {
          "$value": "{color.background.base.hovered}"
        },
        "border": {
          "$value": "{color.border.bold}"
        },
        "border-width": {
          "$value": "{border.width.default}"
        },
        "label": {
          "$value": "{color.text.default}"
        },
        "input": {
          "$value": "{color.text.default}"
        },
        "placeholder": {
          "$value": "{color.text.subtlest}"
        },
        "icon": {
          "$value": "{color.icon.subtlest}"
        },
        "supporting": {
          "$value": "{color.text.subtlest}"
        },
        "counter": {
          "$value": "{color.text.subtlest}"
        },
        "required": {
          "$value": "{color.text.role.error}"
        },
        "addon-container": {
          "$value": "{color.background.neutral.default}"
        },
        "addon-label": {
          "$value": "{color.text.subtle}"
        },
        "error-icon": {
          "$value": "{color.icon.role.error}"
        }
      },
      "focused": {
        "container": {
          "$value": "{color.background.base.default}"
        },
        "border": {
          "$value": "{color.border.focus}"
        },
        "border-width": {
          "$value": "{border.width.focus}"
        },
        "label": {
          "$value": "{color.text.default}"
        },
        "input": {
          "$value": "{color.text.default}"
        },
        "placeholder": {
          "$value": "{color.text.subtlest}"
        },
        "icon": {
          "$value": "{color.icon.default}"
        },
        "supporting": {
          "$value": "{color.text.subtlest}"
        },
        "counter": {
          "$value": "{color.text.subtlest}"
        },
        "required": {
          "$value": "{color.text.role.error}"
        },
        "addon-container": {
          "$value": "{color.background.neutral.default}"
        },
        "addon-label": {
          "$value": "{color.text.subtle}"
        },
        "error-icon": {
          "$value": "{color.icon.role.error}"
        }
      },
      "error": {
        "container": {
          "$value": "{color.background.base.default}"
        },
        "border": {
          "$value": "{color.border.error}"
        },
        "border-width": {
          "$value": "{border.width.default}"
        },
        "label": {
          "$value": "{color.text.default}"
        },
        "input": {
          "$value": "{color.text.default}"
        },
        "placeholder": {
          "$value": "{color.text.subtlest}"
        },
        "icon": {
          "$value": "{color.icon.subtlest}"
        },
        "supporting": {
          "$value": "{color.text.role.error}"
        },
        "counter": {
          "$value": "{color.text.role.error}"
        },
        "required": {
          "$value": "{color.text.role.error}"
        },
        "addon-container": {
          "$value": "{color.background.neutral.default}"
        },
        "addon-label": {
          "$value": "{color.text.subtle}"
        },
        "error-icon": {
          "$value": "{color.icon.role.error}"
        }
      },
      "disabled": {
        "container": {
          "$value": "{color.background.disabled}"
        },
        "border": {
          "$value": "{color.border.disabled}"
        },
        "border-width": {
          "$value": "{border.width.default}"
        },
        "label": {
          "$value": "{color.text.disabled}"
        },
        "input": {
          "$value": "{color.text.disabled}"
        },
        "placeholder": {
          "$value": "{color.text.disabled}"
        },
        "icon": {
          "$value": "{color.icon.disabled}"
        },
        "supporting": {
          "$value": "{color.text.disabled}"
        },
        "counter": {
          "$value": "{color.text.disabled}"
        },
        "required": {
          "$value": "{color.text.disabled}"
        },
        "addon-container": {
          "$value": "{color.background.disabled}"
        },
        "addon-label": {
          "$value": "{color.text.disabled}"
        },
        "error-icon": {
          "$value": "{color.icon.disabled}"
        }
      },
      "read-only": {
        "container": {
          "$value": "{color.background.base.subtlest}"
        },
        "border": {
          "$value": "{color.border.default}"
        },
        "border-width": {
          "$value": "{border.width.default}"
        },
        "label": {
          "$value": "{color.text.default}"
        },
        "input": {
          "$value": "{color.text.default}"
        },
        "placeholder": {
          "$value": "{color.text.subtlest}"
        },
        "icon": {
          "$value": "{color.icon.subtlest}"
        },
        "supporting": {
          "$value": "{color.text.subtlest}"
        },
        "counter": {
          "$value": "{color.text.subtlest}"
        },
        "required": {
          "$value": "{color.text.role.error}"
        },
        "addon-container": {
          "$value": "{color.background.neutral.default}"
        },
        "addon-label": {
          "$value": "{color.text.subtle}"
        },
        "error-icon": {
          "$value": "{color.icon.role.error}"
        }
      }
    }
  }
}
